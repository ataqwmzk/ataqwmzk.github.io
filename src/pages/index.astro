---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.split('/').filter(Boolean).map((s) => '/' + s).join('');

const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const own = posts.filter((post) => post.data.author !== 'ai');
const latest = own.slice(0, 3);
const hasAi = posts.some((post) => post.data.author === 'ai');

const showWorks = false;

const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
---

<Base>
  <section class="hero">
    <p class="eyebrow">PORTFOLIO &amp; BLOG</p>
    <h1>izuna</h1>
    <p class="subname">ata</p>
    <p class="lead">はじめまして。<br /><span class="nb">izuna（いずな・いず）でも、</span><span class="nb">ata(あた)でも、</span><span class="nb">好きなように呼んでください。</span><br /><span class="nb">メッセージはマシュマロか</span><span class="nb">Xからお願いします！</span></p>
    <ul class="chips">
      <li>グラフィックデザイン</li>
      <li>動画編集</li>
    </ul>
  </section>

  <section id="about" class="block about">
    <div class="head">
      <div class="line" aria-hidden="true"></div>
      <h2>About</h2>
      <p class="sub">自己紹介</p>
    </div>
    <div class="body">
      <p>モーショングラフィックスと3DCGに惹かれています。よくAIを使っています。基本的にAIを使うことに異存はありません。</p>
      <p class="muted">使っているツール：After Effects / Illustrator / Photoshop / Blender / Figma / Claude</p>
    </div>
  </section>

  {showWorks && (
    <section id="works" class="block">
      <div class="line" aria-hidden="true"></div>
      <h2>Works</h2>
      <p class="sub">作品</p>
    </section>
  )}

  <section id="blog" class="block">
    <div class="line" aria-hidden="true"></div>
    <div class="head-row">
      <div>
        <h2>Blog</h2>
        <p class="sub">自分で書いた記事</p>
      </div>
      <a class="more" href={`${base}/blog/`}>すべての記事 →</a>
    </div>
    <ul class="post-list">
      {latest.map((post) => (
        <li>
          <a href={`${base}/blog/${post.id}/`}>
            <span class="date">{fmt(post.data.date)}</span>
            <span class="title">
              <span class="t">{post.data.title}</span>
              {post.data.summary && <span class="summary">{post.data.summary}</span>}
            </span>
            <span class="tag">{post.data.author === 'collab' ? (<><span class="badge">AIと共作</span><span class="cat">{post.data.tag}</span></>) : (<span class="badge">{post.data.tag}</span>)}</span>
          </a>
        </li>
      ))}
    </ul>
    {hasAi && (
      <p class="ai-link"><a href={`${base}/blog/#ai`}>AIがまとめた記事を見る →</a></p>
    )}
  </section>

  <section id="links" class="block">
    <div class="line" aria-hidden="true"></div>
    <h2>Links</h2>
    <p class="sub">SNS・リンク</p>
    <div class="buttons">
      <a href="https://x.com/4xwmxr">X</a>
      <a href="https://www.instagram.com/lzuna0032/">Instagram</a>
      <a href="https://marshmallow-qa.com/uqk438rosolpgon">マシュマロ</a>
      <a href="https://www.youtube.com/channel/UCpERdVdpvnHvF16oGLK3tDA">YouTube</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 112px 0 96px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .eyebrow {
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.08em;
  }

  h1 {
    font-size: 56px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .subname {
    font-size: 18px;
    font-weight: 500;
    color: var(--accent);
    margin-top: -12px;
  }

  .lead {
    font-size: 20px;
    color: #3a3a3a;
    max-width: 560px;
  }

  .lead .nb {
    display: inline-block;
  }

  .chips {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chips li {
    font-size: 13px;
    padding: 6px 14px;
    border: 1px solid var(--chip);
    border-radius: 999px;
    color: #3a3a3a;
  }

  .about {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 64px;
  }

  .about .head {
    flex: 1 1 200px;
  }

  .about .body {
    flex: 999 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 24px;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .buttons a {
    padding: 12px 22px;
    border: 1px solid var(--chip);
    border-radius: 999px;
    font-size: 14px;
  }

  .buttons a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .ai-link {
    margin-top: 20px;
    font-size: 14px;
  }

  .ai-link a {
    color: var(--muted);
  }

  .ai-link a:hover {
    color: var(--accent);
  }
</style>
