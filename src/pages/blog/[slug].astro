---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
const base = import.meta.env.BASE_URL.split('/').filter(Boolean).map((s) => '/' + s).join('');

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const isAi = post.data.author === 'ai';
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
---

<Base title={`${post.data.title} | izuna0032`} description={post.data.summary ?? post.data.title}>
  <article class="article">
    <p class="meta">{fmt(post.data.date)} · {post.data.tag}{isAi && ' · AI作成'}</p>
    <h1>{post.data.title}</h1>
    {post.data.summary && <p class="summary">{post.data.summary}</p>}
    {isAi && (
      <aside class="ai-note">
        <span class="badge">AI作成</span>
        <p>この記事は、Claude（AI）が調べてまとめたものです。内容が古かったり、間違っていたりすることがあるので、大事なことは元の情報も確認してください。</p>
      </aside>
    )}
    <div class="prose">
      <Content />
    </div>
    <p class="back"><a href={`${base}/blog/`}>← ブログ一覧へ</a></p>
  </article>
</Base>

<style>
  .article {
    padding: 72px 0;
    max-width: 680px;
    margin: 0 auto;
  }

  .meta {
    font-size: 14px;
    color: var(--muted);
  }

  h1 {
    margin-top: 12px;
    font-size: 36px;
    line-height: 1.3;
    font-weight: 600;
  }

  .summary {
    margin-top: 16px;
    color: var(--muted);
  }

  .ai-note {
    margin-top: 28px;
    padding: 16px 20px;
    border: 1px solid var(--accent);
    border-radius: 12px;
    background: #f5f8ff;
    font-size: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
  }

  .prose {
    margin-top: 40px;
  }

.prose :global(.buttons) {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 20px 0;
  }

  .prose :global(.buttons a) {
    padding: 12px 22px;
    border: 1px solid var(--chip);
    border-radius: 999px;
    font-size: 14px;
    text-decoration: none;
  }

  .prose :global(.buttons a:hover) {
    border-color: var(--accent);
    color: var(--accent);
  }

.prose :global(.series) {
    margin: 0 0 20px;
    font-size: 13px;
  }

  .prose :global(.series a) {
    color: var(--muted);
  }

  .prose :global(.series a:hover) {
    color: var(--accent);
  }

  .back {
    margin-top: 56px;
    font-size: 14px;
  }
</style>
