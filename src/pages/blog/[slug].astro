---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
---

<Base title={`${post.data.title} | ata_あた`} description={post.data.summary ?? post.data.title}>
  <article class="article">
    <p class="meta">{fmt(post.data.date)} · {post.data.tag}</p>
    <h1>{post.data.title}</h1>
    {post.data.summary && <p class="summary">{post.data.summary}</p>}
    <div class="prose">
      <Content />
    </div>
    <p class="back"><a href="/blog/">← ブログ一覧へ</a></p>
  </article>
</Base>

<style>
  .article {
    padding: 72px 0;
    max-width: 680px;
    margin: 0 auto;
  }

  .meta {
    font-size: 14px;
    color: var(--muted);
  }

  h1 {
    margin-top: 12px;
    font-size: 36px;
    line-height: 1.3;
    font-weight: 600;
  }

  .summary {
    margin-top: 16px;
    color: var(--muted);
  }

  .prose {
    margin-top: 40px;
  }

  .back {
    margin-top: 56px;
    font-size: 14px;
  }
</style>
