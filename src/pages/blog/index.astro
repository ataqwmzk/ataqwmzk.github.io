---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.split('/').filter(Boolean).map((s) => '/' + s).join('');

const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const own = posts.filter((post) => post.data.author === 'self');
const ai = posts.filter((post) => post.data.author === 'ai');

const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
---

<Base title="Blog | ata_あた" description="雑記・知識の共有">
  <section class="block">
    <div class="line" aria-hidden="true"></div>
    <h2>Blog</h2>
    <p class="sub">自分で書いた記事</p>
    <ul class="post-list" style="margin-top: 32px">
      {own.map((post) => (
        <li>
          <a href={`${base}/blog/${post.id}/`}>
            <span class="date">{fmt(post.data.date)}</span>
            <span class="title">
              <span class="t">{post.data.title}</span>
              {post.data.summary && <span class="summary">{post.data.summary}</span>}
            </span>
            <span class="tag">{post.data.tag}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {ai.length > 0 && (
    <section id="ai" class="block">
      <div class="line" aria-hidden="true"></div>
      <h2>AI Notes</h2>
      <p class="sub">Claude（AI）が調べてまとめた記事</p>
      <ul class="post-list" style="margin-top: 32px">
        {ai.map((post) => (
          <li>
            <a href={`${base}/blog/${post.id}/`}>
              <span class="date">{fmt(post.data.date)}</span>
              <span class="title">
                <span class="t">{post.data.title}</span>
                {post.data.summary && <span class="summary">{post.data.summary}</span>}
              </span>
              <span class="tag"><span class="badge">AI作成</span>{post.data.tag}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .block {
    padding: 72px 0;
  }
</style>
